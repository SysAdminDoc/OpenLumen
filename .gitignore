# Gradle
.gradle/
build/
**/build/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
gradle-wrapper.properties.bak

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/
.externalNativeBuild/
.cxx/

# Kotlin
.kotlin/

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Build outputs
*.apk
*.aab
*.aar
*.dex
release/
*.hprof

# Signing
*.jks
*.keystore
keystore.properties
signing.properties

# AI working files (local only, never committed)
CLAUDE.md
CODEX_CHANGELOG.md
.claude/
.cursor/
.aider*

# JVM crash debris. Gradle and Kotlin daemons drop these at the repo root,
# and a replay log runs to megabytes.
hs_err_pid*.log
replay_pid*.log

# Misc
*.bak
*.log
*.tmp

# Markdown files local-only (except README and the published docs)
*.md
!README.md
!CONTRIBUTING.md
!SECURITY.md
!docs/*.md

# AI config
AGENTS.md
.codex/
.ai/
PROJECT_CONTEXT.md
CONTINUATION_PROMPT.md

# Written by --write-verification-metadata as a scratch comparison. Gradle
# reads only verification-metadata.xml, so a committed copy is 316 KB of
# dead weight that drifts from the real file and trips the secret scan.
gradle/verification-metadata.dryrun.xml
