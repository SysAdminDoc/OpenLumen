<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget-picker preview for both widgets.

    previewImage used to point straight at ic_lumen_tile, which is a white
    glyph on nothing. In a picker with a light background that is a white
    shape on white. This puts the same glyph on the widget's own backplate,
    so it reads on either launcher.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!--
        drawable, not bitmap: ic_lumen_tile is a vector, and a bitmap element
        decodes its src as a raster image and throws when that fails. The
        first attempt at this preview would not have rendered at all.
    -->
    <item
        android:drawable="@drawable/ic_lumen_tile"
        android:gravity="center"
        android:width="32dp"
        android:height="32dp" />
</layer-list>
