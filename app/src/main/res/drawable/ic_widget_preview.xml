<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget-picker preview for both widgets.

    previewImage used to point straight at ic_lumen_tile, which is a white
    glyph on nothing: in a picker with a light background, white on white.
    This puts the same glyph on the widget's own backplate.

    The glyph is drawn by ic_widget_glyph rather than referenced directly,
    because ic_lumen_tile has a hardcoded white fill and a layer-list item
    carries no tint attribute. Referencing it here is how the first attempt at
    this reintroduced the very bug it was meant to fix: white on a light
    surface is about 1.1 to 1.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_widget_glyph"
        android:gravity="center"
        android:width="32dp"
        android:height="32dp" />
</layer-list>
