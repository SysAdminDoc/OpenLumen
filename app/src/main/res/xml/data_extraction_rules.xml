<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer scope.
    Include-only list: ONLY these paths are backed up / transferred.

    Included:
      datastore/  — user preferences (filter, schedule, profiles)
      sharedpref/ — notification-prompt one-shot flags

    Excluded by omission:
      crash.log        — device-local crash log, per privacy policy
      diagnostics.log  — device-local event log, per privacy policy

    ScheduleDto.latitude/longitude and solarTimezone (user-entered approximate
    city coordinates plus the selected IANA zone)
    share the DataStore blob with the rest of preferences. Cloud backup only
    includes that blob when Android reports client-side encryption; device
    transfer remains a complete settings migration path.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" requireFlags="clientSideEncryption" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
