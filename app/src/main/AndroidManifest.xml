<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE"
        tools:ignore="UnknownPermission" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <!--
        Deliberately no INTERNET permission. OpenLumen is fully offline, F-Droid clean.
        No crash reporting, no remote config, no telemetry. Ever.
    -->

    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />

   <permission
       android:name="com.openlumen.permission.AUTOMATION"
        android:protectionLevel="signature"
       android:label="@string/perm_automation_label"
       android:description="@string/perm_automation_description" />

    <application
        android:name=".OpenLumenApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenLumen"
        android:directBootAware="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenLumen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.LumenService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent display color tint for eye comfort and sleep hygiene." />
        </service>

        <service
            android:name=".service.LumenTileService"
            android:exported="true"
            android:icon="@drawable/ic_lumen_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!--
                Long-press destination for the QS tile. Android routes the
                long-press intent to this activity instead of generic App Info.
                Honored on API 24+; OpenLumen's minSdk is 26 so this is always
                effective. Tied to roadmap candidate C17.
            -->
            <meta-data
                android:name="android.service.quicksettings.PREFERENCES_ACTIVITY"
                android:value="com.openlumen.MainActivity" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.LockedBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Legacy schedule alarms and bounded retries still use a receiver; current
             schedule alarms target LumenService directly to survive process death. -->
        <receiver
            android:name=".service.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- Android 12+ exact-alarm grant/revocation reconciliation. -->
        <receiver
            android:name=".service.ExactAlarmPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Recompute absolute schedule alarms after clock, timezone, date,
             or the system's next-alarm-clock value changes. -->
        <receiver
            android:name=".service.ScheduleClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Exported on purpose: ADB, Tasker, Termux and Macrodroid all need to
            reach it. It carries no android:permission because a signature
            permission would exclude exactly those callers, and a normal one is
            self-granting. Access control is the shared token checked in
            AutomationReceiver.authorize() (roadmap C250) — see
            docs/automation.md. TURN_OFF stays open as the emergency escape
            hatch.
        -->
       <receiver
           android:name=".service.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.openlumen.action.TURN_OFF" />
                <action android:name="com.openlumen.action.TURN_ON" />
                <action android:name="com.openlumen.action.TOGGLE" />
                <action android:name="com.openlumen.action.REEVALUATE" />
                <action android:name="com.openlumen.action.CYCLE_PRESET" />
                <action android:name="com.openlumen.action.SET_PRESET" />
                <action android:name="com.openlumen.action.RESTORE_PREVIOUS" />
                <action android:name="com.openlumen.action.SET_INTENSITY" />
                <action android:name="com.openlumen.action.SET_DIM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!--
            WorkManager (pulled in transitively by Glance) auto-initializes
            via androidx.startup at process start. On a directBootAware
            Application, that fires before the context's storage paths have
            settled to credential-protected mode, and Room blows up
            constructing WorkDatabase on some Android 10 devices (see
            issue #5: Galaxy S9+ / Android 10). We disable the startup
            initializer and let WorkManager lazy-init via our
            Configuration.Provider when Glance first enqueues work, which
            only happens post-unlock.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            1x1 toggle widget (roadmap C19/C123). Glance renders the
            widget; ACTION_REFRESH still lets LumenService nudge all
            instances after each prefs emission.
        -->
        <receiver
            android:name=".widget.ToggleWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.openlumen.widget.action.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_toggle_info" />
        </receiver>

        <!--
            4x1 preset widget (roadmap C20/C123). Glance renders the
            first four favorited presets as tappable chips. Uses an
            action-namespaced refresh broadcast so it doesn't fight
            ToggleWidget's intent filter.
        -->
        <receiver
            android:name=".widget.PresetWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.openlumen.widget.action.PRESET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_preset_info" />
        </receiver>

    </application>

    <!--
        Package visibility filtering applies to resolveActivity from API 30, and
        the launcher pre-resolves so it can say "could not open that screen"
        instead of throwing. Without these the resolve returns null even though
        startActivity would have worked, so the button reported a failure that
        was not one. Launching never needed visibility; only asking did.

        The Settings actions are here rather than left to the automatic
        visibility of system packages, because that set is documented as
        depending on the device.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
    </queries>
</manifest>
